{
  "publicPort": 8787,
  "adminPort": 8788,
  "asideAccount": "u0",
  "dataDir": "data",
  "sitesDir": "sites",
  "trustedProxyHeader": null,
  "redirectUriAllowlist": [
    "https://claude.ai/api/mcp/auth_callback",
    "https://chatgpt.com/connector_platform_oauth_redirect",
    "https://chatgpt.com/connector/oauth/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "git": { "autoCommit": true },
  "oauth": { "extraResources": [] },
  "onboarding": { "model": "claude-opus-5-5", "effort": "high", "runtime": "auto", "codexModel": null },
  "chatgpt": null,
  "captcha": { "auto": true },
  "tunables": {
    "searchDefaultLimit": 10,
    "searchMaxLimit": 25,
    "searchMaxPage": 10,
    "searchCacheTtlSeconds": 600,
    "readCacheTtlSeconds": 86400,
    "pageChainTtlSeconds": 1800,
    "fetchTextMaxChars": 60000,
    "readDocumentsTotalMaxChars": 120000,
    "readDocumentsMinCharsPerItem": 10000,
    "documentMaxChars": 100000,
    "toolCallBudgetMs": 90000,
    "adapterStepTimeoutMs": 120000,
    "maxConcurrentPerSite": 3,
    "maxConcurrentTasks": 8,
    "concurrentStaggerMs": 500,
    "defaultMinIntervalMs": 1500,
    "coolDownSeconds": 600,
    "warmTabTtlSeconds": 300,
    "captchaAttemptBudgetMs": 45000,
    "captchaInlineMinRemainingMs": 40000,
    "captchaRerunReserveMs": 15000,
    "consecutiveAdapterErrorsToDegrade": 3,
    "healthCheckIntervalSeconds": 86400,
    "minReadChars": 200,
    "accessTokenTtlSeconds": 3600,
    "refreshTokenTtlSeconds": 2592000,
    "consentFailuresPerIp": 5,
    "consentGlobalFailures": 20,
    "consentLockoutSeconds": 900,
    "maxRegisteredClients": 50,
    "clientPurgeAfterDays": 7
  }

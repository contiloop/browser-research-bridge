# Copy to .env (git-ignored) and fill in. Environment variables override config/bridge.json,
# which overrides the built-in defaults (src/app/config.ts). An empty value counts as unset.

# Access passphrase, typed on the OAuth consent page when a research client connects. At least 12
# characters. Normally set on the settings page (Getting started, step 1). While it is empty or too
# short, only the settings page runs (setup-only mode). By hand: `openssl rand -base64 24`.
BRIDGE_PASSPHRASE=

# Public origin that fronts the public listener, e.g. https://bridge.example.com or
# https://<random>.trycloudflare.com (no path, no trailing slash). Clients add <PUBLIC_URL>/mcp.
# Unset: http://localhost:<publicPort> (only clients on this Mac can complete OAuth). See README.
PUBLIC_URL=

# Optional. Anthropic API key for the onboarding agent. Unset: the local Claude Code login is used.
ANTHROPIC_API_KEY=

# Optional overrides of config/bridge.json:
# BRIDGE_PUBLIC_PORT=8787
# BRIDGE_ADMIN_PORT=8788
# BRIDGE_ASIDE_ACCOUNT=u0
# BRIDGE_DATA_DIR=data

# Optional runtime settings (not in config/bridge.json):
# Absolute path of the Aside CLI when `aside` is not on PATH (for example under launchd).
# ASIDE_CLI=/Users/you/.local/bin/aside
# Log level: debug | info | warn | error (default info).
# BRIDGE_LOG_LEVEL=info
# Turn limit of one onboarding agent run, 1-1000 (default 80).
# BRIDGE_ONBOARDING_MAX_TURNS=80
# Absolute path of OpenAI's connection tool (tunnel-client) when it is not on PATH (default: tunnel-client).
# TUNNEL_CLIENT_BIN=/Users/you/.local/bin/tunnel-client
# Absolute path of the Codex CLI used by the helper when `codex` is not on PATH (default: codex).
# CODEX_BIN=/opt/homebrew/bin/codex

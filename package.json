{
  "name": "browser-research-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Account-aware search/read tools for ChatGPT Deep Research and Claude Research, executed in the user's logged-in Aside browser.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=.env src/app/main.ts",
    "dev": "tsx --env-file-if-exists=.env src/app/main.ts",
    "site:validate": "tsx --env-file-if-exists=.env src/adapters/validation/cli.ts",
    "browser:check": "tsx --env-file-if-exists=.env src/adapters/aside/check.ts",
    "site:onboard": "tsx --env-file-if-exists=.env src/adapters/onboarding/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.32.0",
    "hono": "4.13.13",
    "zod": "4.6.5",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
